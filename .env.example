# ====================================================================
# Application
# ====================================================================
# HTTP port the NestJS API gateway listens on
PORT=3001

# Static API key required in the x-api-key header for every /api/emails/*
# request. Generate a secure 32-character random key, e.g.:
#   openssl rand -hex 16
# or
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
API_KEY=replace_me_with_32_char_random_string

# ====================================================================
# Database (PostgreSQL)
# ====================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=smtp_user
DB_PASSWORD=smtp_password
DB_NAME=smtp_logs
# Auto-create tables from Sequelize models on startup. Keep "true" until
# you switch to migrations.
DB_SYNC=true
# Print every SQL query to stdout. Useful for debugging.
DB_LOGGING=false

# ====================================================================
# SMTP transport (used by nodemailer)
# ====================================================================
# When the API runs on the same VPS where the postfix server was
# installed by bash_utils/setup_smtp_server.sh, leave SMTP_HOST=127.0.0.1.
# Postfix accepts unauthenticated relay from 127.0.0.0/8 (mynetworks).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
# Set to "true" only if you connect to a remote SMTP over TLS on port 465.
SMTP_SECURE=false

# Address that appears in the From: header of every outgoing email.
# Must be on a domain you own and that has matching SPF/DKIM/DMARC
# DNS records to avoid being marked as spam.
MAIL_FROM=noreply@example.com
